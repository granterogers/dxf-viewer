<Window x:Class="DxfViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DxfViewer"
        Title="{x:Static local:AppVersion.Full}"
        Width="1200" Height="800"
        Background="{StaticResource WindowBg}"
        AllowDrop="True"
        Topmost="{Binding AlwaysOnTop}">

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}"/>
    <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
    <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding NextTabCommand}"/>
    <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding PrevTabCommand}"/>
  </Window.InputBindings>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBg}" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,0,0,1">
      <!-- Orange accent line at very top (INNERGY brand) -->
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource BrandGradient}"/>
        <DockPanel Margin="10,7">

          <!-- Right: window-level controls, then INNERGY branding.
               Always-on-top sits here rather than with the file/view actions because it
               acts on the window itself, not on the drawing. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
            <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                          Command="{Binding ToggleAlwaysOnTopCommand}"
                          IsChecked="{Binding AlwaysOnTop, Mode=OneWay}"
                          ToolTip="Keep this window above all others">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#128204;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Always on Top" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
            <Border Width="1" Background="#4A4A63" Margin="4,4,10,4"/>
            <TextBlock Text="I N N E R G Y"
                       Foreground="{StaticResource AccentOrange}"
                       FontFamily="{StaticResource BrandFont}"
                       FontSize="11"
                       FontWeight="Normal"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Left: action buttons. Icon plus label, because the icon alone was not
               readable enough to identify an action at a glance. -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding NavPrevCommand}"
                    ToolTip="Previous drawing in this folder">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9664;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Previous" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding NavNextCommand}"
                    ToolTip="Next drawing in this folder">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Next" VerticalAlignment="Center"/>
                <TextBlock Text="&#9654;" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Border Width="1" Background="#4A4A63" Margin="4,4,10,4"/>

            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding OpenFileCommand}"
                    ToolTip="Open a drawing (Ctrl+O)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#128194;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Open File" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding FitCommand}"
                    ToolTip="Fit the drawing to the window (F)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9974;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Fit to Window" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding ExportPngCommand}"
                    ToolTip="Export the current drawing as a PNG image">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#128190;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Export PNG" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                          Command="{Binding ToggleMeasureCommand}"
                          IsChecked="{Binding MeasureMode, Mode=OneWay}"
                          ToolTip="Measure distance between two points (snaps to endpoints and centres)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#128207;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Measure" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                          Command="{Binding ToggleLightBackgroundCommand}"
                          IsChecked="{Binding LightBackground, Mode=OneWay}"
                          ToolTip="Switch between a dark and a light drawing background">
              <StackPanel Orientation="Horizontal">
                <!-- Light bulb: the clearest single glyph for a light/dark switch. -->
                <TextBlock Text="&#128161;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Light Mode" VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>

            <Border Width="1" Background="#4A4A63" Margin="4,4,10,4"/>

            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenWithMicrovellumCommand}"
                    ToolTip="Open the current drawing in Microvellum">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#8599;" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Open with Microvellum" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Border Width="1" Background="#4A4A63" Margin="4,4,10,4"/>

            <TextBlock Text="{x:Static local:AppVersion.Label}"
                       Foreground="{StaticResource TextFaint}"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       VerticalAlignment="Center"
                       ToolTip="{x:Static local:AppVersion.Full}"/>
          </StackPanel>

        </DockPanel>
      </DockPanel>
    </Border>

    <!-- Main content area -->
    <Grid>
      <!-- Empty state -->
      <StackPanel x:Name="EmptyState"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Visibility="{Binding EmptyStateVisibility}">
        <Border Width="64" Height="64" CornerRadius="4"
                Background="{StaticResource BrandGradient}"
                HorizontalAlignment="Center" Opacity="0.85"/>
        <TextBlock Text="No drawing open"
                   FontFamily="{StaticResource BrandFont}"
                   FontSize="22" FontWeight="Light"
                   Foreground="{StaticResource TextPrimary}"
                   HorizontalAlignment="Center" Margin="0,20,0,0"/>
        <TextBlock Text="Drop a DXF or DWG file here, or press Ctrl+O"
                   FontFamily="{StaticResource BrandFont}"
                   FontSize="14" Foreground="{StaticResource TextMuted}"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>

      <!-- Tab control -->
      <TabControl x:Name="MainTabControl"
                  Visibility="{Binding TabsVisibility}"
                  VerticalContentAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  ItemsSource="{Binding Tabs}"
                  SelectedItem="{Binding ActiveTab}">
        <TabControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:DxfTabViewModel}">
            <StackPanel x:Name="TabHeader" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="TabTitle"
                         Text="{Binding Title}"
                         FontFamily="Segoe UI" FontSize="12"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource TextMuted}"
                         MaxWidth="180"
                         TextTrimming="CharacterEllipsis"/>
              <Button x:Name="CloseBtn"
                      Style="{StaticResource TabCloseButton}"
                      Content="&#215;"
                      Command="{Binding DataContext.CloseTabCommand,
                                RelativeSource={RelativeSource AncestorType=TabControl}}"
                      CommandParameter="{Binding}"/>
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                <Setter TargetName="TabTitle" Property="Foreground" Value="#FFFFFF"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate DataType="{x:Type local:DxfTabViewModel}">
            <local:DxfTabControl/>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
